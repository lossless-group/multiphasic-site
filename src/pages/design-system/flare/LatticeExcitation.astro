---
// Flare demo — LatticeExcitation.
// Props, sources, and the two states that matter (defective / annealed) shown
// side by side, plus a driveable instance so a reviewer can scrub the front
// themselves. noindex comes from BoilerPlateHTML.
import BaseThemeLayout from '../../../layouts/BaseThemeLayout.astro';
import Wordmark from '../../../components/basics/Wordmark.astro';
import ModeToggle from '../../../components/ui/ModeToggle.astro';
import LatticeExcitation from '../../../components/flare/LatticeExcitation.astro';

const props = [
  ['source', "'scroll' | 'element' | 'manual'", "'scroll'", 'What drives the front. `element` uses the component’s own traversal of the viewport; `manual` is set from code.'],
  ['progress', 'number', '0', 'Front position, 0 (all defective) → 1 (all annealed). Starting value for `manual`.'],
  ['fixed', 'boolean', 'false', 'Pin behind the whole viewport instead of filling the parent box.'],
  ['spacing', 'number', '62', 'Target lattice constant in px. Widened automatically to hold `maxNodes`.'],
  ['maxNodes', 'number', '620', 'Hard cap on simulated atoms.'],
  ['disorder', 'number', '1', 'Severity of the defective state: jitter, dislocation strength, vacancy rate.'],
  ['tilt', 'number', '-11', 'Front tilt in degrees. 0 sweeps straight left → right.'],
  ['feather', 'number', '190', 'Thickness of the annealing zone in px.'],
  ['seed', 'number', '20260826', 'Deterministic layout. Same seed, same defects.'],
];
---

<BaseThemeLayout title="LatticeExcitation — flare" theme="lattice" mode="dark">
  <header class="ds-chrome">
    <Wordmark size={24} />
    <div class="ds-chrome-right">
      <a href="/design-system/flare/PulseEnvelope">PulseEnvelope</a>
      <a href="/lattice">Direction B</a>
      <ModeToggle />
    </div>
  </header>

  <main class="ds">
    <p class="ds-eyebrow">FLARE · DIRECTION B</p>
    <h1>LatticeExcitation</h1>
    <p class="ds-lede">
      A close-packed atomic plane that begins defective and anneals into order behind a
      travelling excitation front. Canvas 2D. The defective side carries varied bond
      lengths, an edge dislocation, a misoriented grain, and vacancies; all four resolve
      as the front passes.
    </p>

    <section class="ds-block">
      <h2>Scrub the front</h2>
      <p class="ds-note">
        <code>source="manual"</code>. Drag to move the wavefront. The seam running
        top-right is the grain boundary; the extra half-plane sits at lower left.
      </p>
      <div class="ds-stage is-tall" data-scrub-stage>
        <LatticeExcitation source="manual" progress={0.45} spacing={54} maxNodes={520} />
      </div>
      <label class="ds-scrub">
        <span>FRONT</span>
        <input type="range" min="0" max="100" value="45" data-scrub />
        <output data-scrub-out>0.45</output>
      </label>
    </section>

    <section class="ds-block">
      <h2>The two states</h2>
      <p class="ds-note">
        Left is inherited material state. Right is specified. Same lattice, same seed.
      </p>
      <div class="ds-pair">
        <figure>
          <div class="ds-stage"><LatticeExcitation source="manual" progress={0} spacing={50} maxNodes={480} /></div>
          <figcaption>progress = 0 · defective</figcaption>
        </figure>
        <figure>
          <div class="ds-stage"><LatticeExcitation source="manual" progress={1} spacing={50} maxNodes={480} /></div>
          <figcaption>progress = 1 · annealed</figcaption>
        </figure>
      </div>
    </section>

    <section class="ds-block">
      <h2>Disorder</h2>
      <p class="ds-note">
        <code>disorder</code> scales jitter, dislocation strength, and vacancy rate together.
        At 0.3 the material reads as merely imperfect; at 1 it reads as untreated.
      </p>
      <div class="ds-pair">
        <figure>
          <div class="ds-stage"><LatticeExcitation source="manual" progress={0} disorder={0.3} spacing={50} maxNodes={480} seed={7} /></div>
          <figcaption>disorder = 0.3</figcaption>
        </figure>
        <figure>
          <div class="ds-stage"><LatticeExcitation source="manual" progress={0} disorder={1} spacing={50} maxNodes={480} seed={7} /></div>
          <figcaption>disorder = 1</figcaption>
        </figure>
      </div>
    </section>

    <section class="ds-block">
      <h2>Self-driven</h2>
      <p class="ds-note">
        <code>source="element"</code> — the front tracks this box's own passage through
        the viewport. Scroll the page to drive it. A vertical front (<code>tilt={0}</code>)
        for contrast with the page default.
      </p>
      <div class="ds-stage is-tall"><LatticeExcitation source="element" tilt={0} spacing={54} maxNodes={520} /></div>
    </section>

    <section class="ds-block">
      <h2>Props</h2>
      <table class="ds-table">
        <thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Notes</th></tr></thead>
        <tbody>
          {props.map(([n, t, d, note]) => (
            <tr><td><code>{n}</code></td><td>{t}</td><td><code>{d}</code></td><td>{note}</td></tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="ds-block">
      <h2>Motion &amp; cost</h2>
      <ul class="ds-list">
        <li><strong>prefers-reduced-motion:</strong> one static frame of the fully ordered lattice. No rAF, no scroll listener, no thermal jitter. The end state is the argument, so the static frame still makes it.</li>
        <li><strong>Atom cap:</strong> spacing widens until <code>cols × rows ≤ maxNodes</code>. 620 atoms ≈ 1,800 bonds at desktop width.</li>
        <li><strong>Frame rate:</strong> throttled to ~30fps. This is background texture behind an entire page.</li>
        <li><strong>Gating:</strong> IntersectionObserver plus <code>visibilitychange</code>. Offscreen and backgrounded instances stop the loop entirely.</li>
        <li><strong>devicePixelRatio</strong> capped at 2.</li>
        <li><strong>Colour</strong> is read from <code>--fx-lattice-*</code> and re-read on <code>mode-change</code>, which is how light mode inverts to dark-ink-on-white.</li>
      </ul>
    </section>
  </main>

  <script>
    const scrub = document.querySelector<HTMLInputElement>('[data-scrub]');
    const out = document.querySelector<HTMLOutputElement>('[data-scrub-out]');
    const stage = document.querySelector<HTMLElement>('[data-scrub-stage] [data-lattice-excitation]');
    if (scrub && stage) {
      scrub.addEventListener('input', () => {
        const p = Number(scrub.value) / 100;
        if (out) out.value = p.toFixed(2);
        (stage as any).latticeSetProgress?.(p);
      });
    }
  </script>
</BaseThemeLayout>

<style>
  .ds-chrome {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem clamp(1.25rem, 5vw, 3rem);
    border-bottom: 1px solid var(--fx-hairline);
    background: color-mix(in srgb, var(--color-background) 82%, transparent);
    backdrop-filter: blur(14px);
  }
  .ds-chrome-right { display: flex; align-items: center; gap: 1.25rem; }
  .ds-chrome-right a {
    font-family: var(--font-data);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .ds-chrome-right a:hover { color: var(--color-primary); }

  .ds {
    max-width: 64rem;
    margin-inline: auto;
    padding: clamp(2.5rem, 7vw, 4.5rem) clamp(1.25rem, 5vw, 3rem) 8rem;
  }
  .ds-eyebrow {
    font-family: var(--font-data);
    font-size: 0.625rem;
    letter-spacing: 0.28em;
    color: var(--color-accent);
    margin-bottom: 1.25rem;
  }
  .ds h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 6vw, 3.75rem);
    letter-spacing: -0.04em;
    line-height: 0.95;
    color: var(--color-text);
  }
  .ds-lede {
    margin-top: 1.25rem;
    max-width: 52ch;
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }
  .ds-block { margin-top: clamp(3rem, 7vw, 4.5rem); }
  .ds-block h2 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    color: var(--color-text);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--fx-hairline);
  }
  .ds-note {
    margin: 1rem 0 1.5rem;
    max-width: 60ch;
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }
  .ds-note code, .ds-table code, .ds-list code {
    font-family: var(--font-data);
    font-size: 0.8em;
    color: var(--color-conditioned);
  }

  .ds-stage {
    position: relative;
    height: 220px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    overflow: hidden;
  }
  .ds-stage.is-tall { height: 340px; }

  .ds-pair { display: grid; gap: 1rem; }
  @media (min-width: 44rem) { .ds-pair { grid-template-columns: 1fr 1fr; } }
  .ds-pair figure { margin: 0; }
  .ds-pair figcaption {
    margin-top: 0.6rem;
    font-family: var(--font-data);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    color: var(--color-text-faint);
  }

  .ds-scrub {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1rem;
    font-family: var(--font-data);
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    color: var(--color-text-faint);
  }
  .ds-scrub input { flex: 1; max-width: 26rem; accent-color: var(--color-primary); }
  .ds-scrub output { color: var(--color-conditioned); }

  .ds-table { width: 100%; border-collapse: collapse; font-size: 0.8125rem; }
  .ds-table th, .ds-table td {
    text-align: left;
    padding: 0.7rem 0.9rem 0.7rem 0;
    border-bottom: 1px solid var(--fx-hairline);
    vertical-align: top;
    font-family: var(--font-body);
    font-weight: 300;
    color: var(--color-text-muted);
  }
  .ds-table th {
    font-family: var(--font-data);
    font-weight: 400;
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .ds-list { margin: 0; padding-left: 1.1rem; }
  .ds-list li {
    margin-bottom: 0.7rem;
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }
  .ds-list strong { color: var(--color-text); font-weight: 500; }
</style>

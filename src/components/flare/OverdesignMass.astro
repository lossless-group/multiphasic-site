---
/* ============================================================================
 * OverdesignMass — "up to 2× the material and weight, added purely as a hedge",
 * drawn as a part instead of asserted as a number.
 *
 * A structural cross-section is drawn twice: the profile a designer would
 * specify if material state were known (the core), and the profile they
 * actually ship because it isn't (the hedged section). The difference between
 * the two is filled with a hatch and labelled — it is the hedge, and it is the
 * thing that goes away. On reveal the hatch sheds and the section slims to the
 * true-performance profile.
 *
 * The geometry is not eyeballed. Given a `ratio`, the component solves for the
 * thickness scale k that makes the hedged section carry exactly `ratio` times
 * the cross-sectional area of the core, inside the same overall envelope —
 * which is what over-design actually looks like on a drawing. An engineer can
 * check the arithmetic against the readout.
 *
 * Clipped-overlay rather than path morph: seeing the shell that gets removed is
 * more legible than watching one outline slide into another, and it survives
 * browsers without CSS `d` interpolation.
 *
 * COLOR LAW: this component sits on both sides of the beam, so it never picks
 * its own accent. `tone` decides, and the page only ever passes tone="cost" on
 * the left of the beam and tone="gain" on the right.
 * ========================================================================== */

export interface Props {
  /** 'hedged' — ship-as-built, shell present and permanent.
   *  'specified' — the true-performance section alone.
   *  'morph' — starts hedged, sheds the hedge on reveal. */
  state?: 'hedged' | 'specified' | 'morph';
  /** Which part. Both are real sections an engineer reads instantly. */
  profile?: 'i-beam' | 'bracket';
  /** Mass multiplier the hedged section carries. The deck's figure is 2. */
  ratio?: number;
  /** Rendered square size in px. */
  size?: number;
  /** Ink for the hedge shell + core. See COLOR LAW above. */
  tone?: 'cost' | 'gain' | 'neutral';
  /** Show the mono area readout beneath the section. */
  label?: boolean;
  /** What kicks off the shed in state="morph". */
  trigger?: 'scroll' | 'hover';
  class?: string;
}

const {
  state = 'morph',
  profile = 'i-beam',
  ratio = 2,
  size = 220,
  tone = state === 'specified' ? 'gain' : 'cost',
  label = true,
  trigger = 'scroll',
  class: className = '',
} = Astro.props;

/* ---------------------------------------------------------------------------
 * Geometry. Envelope is fixed (a part has to fit where it fits); only section
 * thickness grows. Solve area(k) = ratio * area(1) by bisection — closed forms
 * exist per profile but bisection keeps the two profiles honest under one rule.
 * ------------------------------------------------------------------------- */
const ENV = { x0: 28, x1: 172, y0: 26, y1: 174 };
const W = ENV.x1 - ENV.x0; // 144
const H = ENV.y1 - ENV.y0; // 148

/** Cross-sectional area of the section at thickness scale k. */
function area(k: number): number {
  if (profile === 'bracket') {
    const t = 18 * k;
    return t * H + t * (W - t);
  }
  const t = 13 * k; // flange thickness
  const w = 16 * k; // web thickness
  return W * t * 2 + (H - 2 * t) * w;
}

function solveScale(target: number): number {
  const goal = target * area(1);
  let lo = 1;
  let hi = 6;
  for (let i = 0; i < 60; i++) {
    const mid = (lo + hi) / 2;
    if (area(mid) < goal) lo = mid;
    else hi = mid;
  }
  return (lo + hi) / 2;
}

function pathFor(k: number): string {
  const { x0, x1, y0, y1 } = ENV;
  if (profile === 'bracket') {
    const t = 18 * k;
    return `M${x0},${y0} H${x0 + t} V${y1 - t} H${x1} V${y1} H${x0} Z`;
  }
  const t = 13 * k;
  const w = 16 * k;
  const cx = (x0 + x1) / 2;
  const wl = cx - w / 2;
  const wr = cx + w / 2;
  return [
    `M${x0},${y0}`,
    `H${x1}`,
    `V${y0 + t}`,
    `H${wr}`,
    `V${y1 - t}`,
    `H${x1}`,
    `V${y1}`,
    `H${x0}`,
    `V${y1 - t}`,
    `H${wl}`,
    `V${y0 + t}`,
    `H${x0}`,
    'Z',
  ].join(' ');
}

const k = solveScale(ratio);
const corePath = pathFor(1);
const hedgedPath = pathFor(k);
/** Shell only: hedged outline with the core punched out (evenodd). */
const shellPath = `${hedgedPath} ${corePath}`;
const actualRatio = area(k) / area(1);

const uid = `odm-${Math.random().toString(36).slice(2, 9)}`;
const showShell = state !== 'specified';
const readoutFrom = `${actualRatio.toFixed(2)}×`;
const readoutTo = '1.00×';

const PROFILE_NAME = { 'i-beam': 'I-beam section', bracket: 'L-bracket section' } as const;
const ariaLabel =
  state === 'specified'
    ? `${PROFILE_NAME[profile]} at its true-performance thickness.`
    : `${PROFILE_NAME[profile]} carrying ${actualRatio.toFixed(2)} times the material it needs, the excess drawn as a hatched hedge${
        state === 'morph' ? ' that is removed when material state is specified' : ''
      }.`;
---

<figure
  class:list={['odm', className]}
  data-state={state}
  data-tone={tone}
  data-trigger={trigger}
  style={`--odm-size:${size}px`}
>
  <svg viewBox="0 0 200 200" role="img" aria-label={ariaLabel}>
    <defs>
      <pattern id={`${uid}-hatch`} width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(38)">
        <line x1="0" y1="0" x2="0" y2="7" stroke="currentColor" stroke-width="2.4" />
      </pattern>
    </defs>

    {/* the envelope the part has to live inside — drawn as a datum, not decoration */}
    <rect
      class="odm-envelope"
      x={ENV.x0}
      y={ENV.y0}
      width={W}
      height={H}
      fill="none"
      stroke-dasharray="3 6"
      stroke-width="1"
    />

    {/* the true-performance section: what the part would be if state were specified */}
    <path class="odm-core" d={corePath} fill-rule="evenodd" />

    {/* the hedge: material added only because material state is unknown */}
    {showShell && <path class="odm-shell" d={shellPath} fill-rule="evenodd" fill={`url(#${uid}-hatch)`} />}
    {showShell && <path class="odm-shell-edge" d={hedgedPath} fill="none" stroke-width="1.25" />}
  </svg>

  {
    label && (
      <figcaption class="odm-readout">
        <span class="odm-from">{readoutFrom}</span>
        <span class="odm-to">{readoutTo}</span>
        <span class="odm-unit">section mass</span>
      </figcaption>
    )
  }
</figure>

<script>
  // Sheds the hedge when the section is genuinely on screen. One observer for
  // every instance on the page; hover-triggered instances are pure CSS.
  (() => {
    const targets = document.querySelectorAll<HTMLElement>('.odm[data-state="morph"][data-trigger="scroll"]');
    if (!targets.length) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      targets.forEach((t) => t.setAttribute('data-shed', 'true'));
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.setAttribute('data-shed', 'true');
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.55 }
    );
    targets.forEach((t) => io.observe(t));
  })();
</script>

<style>
  .odm {
    margin: 0;
    width: var(--odm-size, 220px);
    max-width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .odm svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
    /* the hatch pattern resolves currentColor against the <svg>, not the path */
    color: var(--odm-ink);
  }

  /* tone drives every ink in here; the component never names a side */
  .odm[data-tone='cost'] {
    --odm-ink: var(--color-cost);
    --odm-core: var(--color-past-text);
    --odm-datum: var(--color-past-hairline);
    --odm-caption: var(--color-past-text-muted);
  }
  .odm[data-tone='gain'] {
    --odm-ink: var(--color-gain);
    --odm-core: var(--color-gain);
    --odm-datum: var(--color-future-hairline);
    --odm-caption: var(--color-future-text-muted);
  }
  .odm[data-tone='neutral'] {
    --odm-ink: var(--color-text-muted);
    --odm-core: var(--color-text);
    --odm-datum: var(--color-border);
    --odm-caption: var(--color-text-muted);
  }

  .odm-envelope {
    stroke: var(--odm-datum);
  }
  .odm-core {
    fill: var(--odm-core);
  }
  .odm-shell,
  .odm-shell-edge {
    color: var(--odm-ink);
    stroke: var(--odm-ink);
    transform-origin: 100px 100px;
    transition: opacity 900ms cubic-bezier(0.22, 1, 0.36, 1), transform 900ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* morph: the hedge is present until the reader arrives, then it lets go */
  .odm[data-state='morph'] .odm-shell,
  .odm[data-state='morph'] .odm-shell-edge {
    opacity: 1;
  }
  .odm[data-state='morph'][data-shed='true'] .odm-shell,
  .odm[data-state='morph'][data-shed='true'] .odm-shell-edge {
    opacity: 0;
    transform: scale(1.06);
  }
  .odm[data-state='morph'][data-trigger='hover']:hover .odm-shell,
  .odm[data-state='morph'][data-trigger='hover']:hover .odm-shell-edge,
  .odm[data-state='morph'][data-trigger='hover']:focus-within .odm-shell,
  .odm[data-state='morph'][data-trigger='hover']:focus-within .odm-shell-edge {
    opacity: 0;
    transform: scale(1.06);
  }

  .odm-readout {
    font-family: var(--font-data);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    color: var(--odm-caption);
  }
  .odm-from {
    color: var(--odm-ink);
    transition: opacity 700ms ease, text-decoration-color 700ms ease;
    text-decoration: line-through;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
  }
  .odm-to {
    color: var(--odm-core);
    opacity: 0.28;
    transition: opacity 700ms ease 200ms;
  }
  .odm[data-state='specified'] .odm-from {
    display: none;
  }
  .odm[data-state='specified'] .odm-to,
  .odm[data-shed='true'] .odm-to,
  .odm[data-state='morph'][data-trigger='hover']:hover .odm-to {
    opacity: 1;
  }
  .odm[data-state='hedged'] .odm-to {
    display: none;
  }
  .odm[data-shed='true'] .odm-from,
  .odm[data-state='morph'][data-trigger='hover']:hover .odm-from {
    opacity: 0.45;
    text-decoration-color: currentColor;
  }
  .odm-unit {
    margin-left: auto;
    text-transform: uppercase;
    opacity: 0.7;
  }

  /* Static fallback with meaning: the hedge is drawn faint rather than removed,
   * so the shell is still legible as "material that did not need to be there". */
  @media (prefers-reduced-motion: reduce) {
    .odm[data-state='morph'] .odm-shell,
    .odm[data-state='morph'] .odm-shell-edge {
      opacity: 0.34;
      transform: none;
      transition: none;
    }
    .odm[data-state='morph'][data-shed='true'] .odm-shell,
    .odm[data-state='morph'][data-shed='true'] .odm-shell-edge {
      opacity: 0.34;
      transform: none;
    }
  }
</style>

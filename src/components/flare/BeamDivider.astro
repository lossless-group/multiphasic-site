---
/* ============================================================================
 * BeamDivider — the seam of light that divides every diptych.
 *
 * The source deck opens on a fractured bridge: two halves and a gap. Later the
 * same two halves are rejoined by a beam. This component is that beam, made
 * into a UI primitive: a sharp bright core, a soft bloom falling off to either
 * side, a faint halo, and a slow living drift so it never reads as a border.
 *
 * Everything here is CSS gradients plus one small SVG for the travelling
 * glints. No WebGL, no animation library — the falloff of a beam is exactly
 * what a linear-gradient is for.
 *
 * Reads only kebab-case semantic tokens:
 *   --color-beam-core / --color-beam-bloom / --color-beam-halo
 *   --fx-beam-opacity / --fx-beam-box / --fx-drift-duration / --fx-glow-opacity
 *
 * Reduced motion: the drift and the glint travel stop. The beam still paints
 * its full core + bloom + halo, so the seam is never lost — only the life is.
 * ========================================================================== */

export interface Props {
  /** vertical seam (default, the diptych case) or horizontal seam (mobile stack). */
  orientation?: 'vertical' | 'horizontal';
  /** how hard the beam burns: core width, bloom spread, halo reach. */
  intensity?: 'low' | 'medium' | 'high';
  /** Length of the seam along its own axis. Any CSS length; `100%` fills the slot. */
  height?: string;
  /** Whether this beam drives a reveal, and how the reader controls it.
   *  'none'   — decorative seam.
   *  'scroll' — the page's scroll driver moves it; no affordance rendered.
   *  'drag'   — renders a grab handle (role="slider", arrow-key operable). */
  reveal?: 'none' | 'scroll' | 'drag';
  /** The slow vertical wander that keeps the beam alive. */
  drift?: boolean;
  /** Accessible name for the drag handle. Ignored unless reveal="drag". */
  label?: string;
  class?: string;
}

const uid = `bm-${Math.random().toString(36).slice(2, 9)}`;

const {
  orientation = 'vertical',
  intensity = 'medium',
  height = '100%',
  reveal = 'none',
  drift = true,
  label = 'Slide the beam to compare today against a specified material state',
  class: className = '',
} = Astro.props;
---

<div
  class:list={['beam', className]}
  data-orientation={orientation}
  data-intensity={intensity}
  data-reveal={reveal}
  data-drift={drift ? 'true' : 'false'}
  style={`--beam-length:${height}`}
>
  <span class="beam-halo" aria-hidden="true"></span>
  <span class="beam-bloom" aria-hidden="true"></span>
  <span class="beam-core" aria-hidden="true"></span>

  <svg class="beam-glints" viewBox="0 0 40 600" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <defs>
      <filter id={`${uid}-soft`} x="-120%" y="-40%" width="340%" height="180%">
        <feGaussianBlur stdDeviation="3.5" />
      </filter>
      <linearGradient id={`${uid}-glint`} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="currentColor" stop-opacity="0" />
        <stop offset="50%" stop-color="currentColor" stop-opacity="1" />
        <stop offset="100%" stop-color="currentColor" stop-opacity="0" />
      </linearGradient>
    </defs>
    <g class="beam-glint-group" filter={`url(#${uid}-soft)`}>
      <ellipse cx="20" cy="90" rx="15" ry="26" fill={`url(#${uid}-glint)`} opacity="0.55" />
      <ellipse cx="20" cy="288" rx="19" ry="44" fill={`url(#${uid}-glint)`} opacity="0.7" />
      <ellipse cx="20" cy="470" rx="13" ry="20" fill={`url(#${uid}-glint)`} opacity="0.45" />
    </g>
  </svg>

  {
    reveal === 'drag' && (
      <button
        type="button"
        class="beam-handle"
        data-beam-handle
        role="slider"
        aria-label={label}
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="100"
        aria-valuetext="Fully specified"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.5 8.5 6 12l3.5 3.5M14.5 8.5 18 12l-3.5 3.5" />
        </svg>
      </button>
    )
  }
</div>

<style>
  .beam {
    position: relative;
    pointer-events: none;
    color: var(--color-beam-bloom);
    opacity: var(--fx-beam-opacity, 1);
    --core-w: 1.5px;
    --bloom-w: 26px;
    --halo-w: 62px;
    --core-a: 0.95;
  }

  .beam[data-intensity='low'] {
    --core-w: 1px;
    --bloom-w: 13px;
    --halo-w: 34px;
    --core-a: 0.7;
  }
  .beam[data-intensity='high'] {
    --core-w: 2.5px;
    --bloom-w: 46px;
    --halo-w: 88px;
    --core-a: 1;
  }

  .beam[data-orientation='vertical'] {
    width: var(--fx-beam-box, 110px);
    height: var(--beam-length, 100%);
  }
  .beam[data-orientation='horizontal'] {
    height: var(--fx-beam-box, 110px);
    width: var(--beam-length, 100%);
  }

  .beam-core,
  .beam-bloom,
  .beam-halo,
  .beam-glints {
    position: absolute;
    inset: 0;
    margin: auto;
    display: block;
  }

  /* — the sharp centre. One hairline, near-white, the only hard edge here. — */
  .beam-core {
    background: var(--color-beam-core);
    opacity: var(--core-a);
    box-shadow: 0 0 calc(var(--bloom-w) * 0.4) color-mix(in srgb, var(--color-beam-core) 60%, transparent);
  }
  .beam[data-orientation='vertical'] .beam-core {
    width: var(--core-w);
    height: 100%;
  }
  .beam[data-orientation='horizontal'] .beam-core {
    height: var(--core-w);
    width: 100%;
  }

  /* — the bloom: a symmetric falloff, tight — */
  .beam-bloom {
    background: linear-gradient(
      to right,
      transparent 0%,
      color-mix(in srgb, var(--color-beam-bloom) 55%, transparent) 44%,
      var(--color-beam-bloom) 50%,
      color-mix(in srgb, var(--color-beam-bloom) 55%, transparent) 56%,
      transparent 100%
    );
    filter: blur(1.5px);
  }
  .beam[data-orientation='vertical'] .beam-bloom {
    width: var(--bloom-w);
    height: 100%;
  }
  .beam[data-orientation='horizontal'] .beam-bloom {
    height: var(--bloom-w);
    width: 100%;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      color-mix(in srgb, var(--color-beam-bloom) 55%, transparent) 44%,
      var(--color-beam-bloom) 50%,
      color-mix(in srgb, var(--color-beam-bloom) 55%, transparent) 56%,
      transparent 100%
    );
  }

  /* — the halo: the wide, faint spill that makes it read as light and not ink — */
  .beam-halo {
    background: linear-gradient(to right, transparent, var(--color-beam-halo) 50%, transparent);
    opacity: calc(0.34 + var(--fx-glow-opacity, 0.1) * 0.9);
    filter: blur(10px);
  }
  .beam[data-orientation='vertical'] .beam-halo {
    width: var(--halo-w);
    height: 100%;
  }
  .beam[data-orientation='horizontal'] .beam-halo {
    height: var(--halo-w);
    width: 100%;
    background: linear-gradient(to bottom, transparent, var(--color-beam-halo) 50%, transparent);
  }

  /* — travelling glints: where the beam is momentarily hotter — */
  .beam-glints {
    color: var(--color-beam-core);
    mix-blend-mode: screen;
    opacity: 0.85;
  }
  .beam[data-orientation='vertical'] .beam-glints {
    width: calc(var(--bloom-w) * 1.9);
    height: 100%;
  }
  .beam[data-orientation='horizontal'] .beam-glints {
    display: none;
  }

  .beam[data-drift='true'] .beam-glint-group {
    animation: beam-drift var(--fx-drift-duration, 14s) ease-in-out infinite alternate;
  }
  .beam[data-drift='true'] .beam-core {
    animation: beam-breathe calc(var(--fx-drift-duration, 14s) * 0.42) ease-in-out infinite alternate;
  }

  @keyframes beam-drift {
    from {
      transform: translateY(-9%);
    }
    to {
      transform: translateY(9%);
    }
  }
  @keyframes beam-breathe {
    from {
      opacity: calc(var(--core-a) * 0.78);
    }
    to {
      opacity: var(--core-a);
    }
  }

  /* — the drag affordance — */
  .beam-handle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: auto;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    padding: 0;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-beam-core) 70%, transparent);
    background: color-mix(in srgb, var(--color-beam-core) 16%, transparent);
    backdrop-filter: blur(6px);
    color: var(--color-beam-core);
    cursor: ew-resize;
    touch-action: none;
    transition: background-color 140ms ease, transform 140ms ease;
  }
  .beam-handle svg {
    width: 1.05rem;
    height: 1.05rem;
  }
  .beam-handle:hover,
  .beam-handle:focus-visible {
    background: color-mix(in srgb, var(--color-beam-core) 34%, transparent);
    transform: translate(-50%, -50%) scale(1.06);
  }
  .beam-handle:focus-visible {
    outline: 2px solid var(--color-beam-core);
    outline-offset: 3px;
  }

  @media (max-width: 899px) {
    .beam-handle {
      display: none;
    }
  }

  /* Static fallback: the seam keeps its full core, bloom and halo. Only the
   * life goes away — the divider is never lost. */
  @media (prefers-reduced-motion: reduce) {
    .beam[data-drift='true'] .beam-glint-group,
    .beam[data-drift='true'] .beam-core {
      animation: none;
    }
    .beam-glints {
      opacity: 0.55;
    }
  }
</style>

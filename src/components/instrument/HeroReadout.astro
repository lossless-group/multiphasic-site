---
/* HeroReadout — beat 1, set as the front plate of a test report.
 *
 * The hero is a single ruled frame with corner ticks, a coral rule under the
 * headline (the deck's own signature move, and the one coral on this screen),
 * and a three-column spec strip along the bottom whose values are derived
 * from beats 5 and 8 rather than invented here. The kicker — the line the
 * whole argument turns on — is set in the data face as a caption, because in
 * a report the caption is where the finding goes. */
import type { CollectionEntry } from 'astro:content';

export interface Props {
  beat: CollectionEntry<'beats'>;
  spec: { label: string; value: string }[];
}
const { beat, spec } = Astro.props;
const d = beat.data as any;
---

<section class="hero" id={d.slug_id}>
  <div class="hero-frame">
    <span class="tick tl"></span><span class="tick tr"></span>
    <span class="tick bl"></span><span class="tick br"></span>

    <p class="hero-eyebrow">{d.eyebrow}</p>

    <h1 class="hero-title">{d.title}</h1>
    <span class="hero-strike" data-reveal></span>

    {d.sub && <p class="hero-sub">{d.sub}</p>}

    <div class="hero-body"><slot /></div>

    {d.cta_label && (
      <a class="hero-cta" href={d.cta_href ?? '#contact'}>
        <span>{d.cta_label}</span>
        <span class="hero-cta-arrow">&rarr;</span>
      </a>
    )}

    <dl class="hero-spec">
      {spec.map((s) => (
        <div class="hero-spec-cell">
          <dt>{s.label}</dt>
          <dd>{s.value}</dd>
        </div>
      ))}
    </dl>
  </div>

  {d.kicker && (
    <p class="hero-kicker">
      <span class="hero-kicker-mark">&#8212;</span>
      {d.kicker}
    </p>
  )}
</section>

<style>
  .hero { padding-block: clamp(2.5rem, 6vw, 5rem) 0; }

  .hero-frame {
    position: relative;
    border: 1px solid var(--color-border);
    background: var(--color-plate);
    padding: clamp(1.75rem, 4.5vw, 3.5rem);
  }

  /* Corner ticks — the registration marks on a plotted sheet. */
  .tick { position: absolute; width: 11px; height: 11px; }
  .tick::before, .tick::after {
    content: '';
    position: absolute;
    background: var(--color-primary);
  }
  .tick::before { width: 11px; height: 1px; }
  .tick::after { width: 1px; height: 11px; }
  .tl { top: -1px; left: -1px; }
  .tr { top: -1px; right: -1px; }
  .bl { bottom: -1px; left: -1px; }
  .br { bottom: -1px; right: -1px; }
  .tr::before, .tr::after { right: 0; }
  .bl::before, .bl::after { bottom: 0; }
  .br::before, .br::after { right: 0; bottom: 0; }

  .hero-eyebrow {
    font-family: var(--font-eyebrow);
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    color: var(--color-primary);
    margin-bottom: clamp(1.5rem, 4vw, 2.75rem);
  }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.05rem, 6.2vw, 4.4rem);
    line-height: 1.03;
    letter-spacing: -0.035em;
    max-width: 19ch;
    text-wrap: balance;
  }

  /* The one coral on this screen. Deck-native: a short heavy rule under H1. */
  .hero-strike {
    display: block;
    width: 5.5rem;
    height: 5px;
    background: var(--color-accent);
    margin-top: 1.5rem;
    transform-origin: left center;
  }
  :global(html.has-reveal) .hero-strike { transform: scaleX(0); }
  :global(html.has-reveal) .hero-strike.is-in {
    transform: scaleX(1);
    transition: transform 700ms cubic-bezier(0.2, 0.7, 0.25, 1) 220ms;
  }

  .hero-sub {
    margin-top: 1.75rem;
    max-width: 52ch;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  .hero-body {
    margin-top: 1.15rem;
    max-width: 56ch;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }
  .hero-body :global(p) { margin: 0; }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: 2.25rem;
    padding: 0.75rem 1.25rem;
    border: 1px solid var(--color-primary);
    font-family: var(--font-data);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-primary);
    transition: background-color 180ms ease, color 180ms ease;
  }
  .hero-cta:hover {
    background: var(--color-primary);
    color: var(--color-background);
  }
  .hero-cta:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 3px; }
  .hero-cta-arrow { transition: transform 180ms ease; }
  .hero-cta:hover .hero-cta-arrow { transform: translateX(3px); }

  .hero-spec {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1px;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    border-top: 1px solid var(--color-border);
    background: var(--color-border);
  }
  .hero-spec-cell {
    background: var(--color-background);
    padding: 1rem 1.1rem 1.1rem;
  }
  .hero-spec dt {
    font-family: var(--font-data);
    font-size: 0.63rem;
    letter-spacing: 0.2em;
    color: var(--color-text-faint);
    margin-bottom: 0.5rem;
  }
  .hero-spec dd {
    margin: 0;
    font-family: var(--font-data);
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--color-text);
  }

  .hero-kicker {
    display: flex;
    gap: 1rem;
    margin: 1.75rem 0 0;
    font-family: var(--font-data);
    font-size: clamp(0.82rem, 1.5vw, 0.98rem);
    line-height: 1.6;
    letter-spacing: 0.01em;
    color: var(--color-text-muted);
    max-width: 62ch;
  }
  .hero-kicker-mark { color: var(--color-primary); }

  @media (max-width: 640px) {
    .hero-title { letter-spacing: -0.025em; max-width: none; }
  }
</style>

---
/* SqueezeLedger — beat 4. Three duty cycles the frontier is asking for,
 * set as a ruled ledger. The `note` field carries the actual failure modes,
 * so it goes in the data face on its own line: in a report, the failure mode
 * is a classification, not prose. No coral on this screen. */
import type { CollectionEntry } from 'astro:content';
import SectionHeader from './SectionHeader.astro';

export interface Props { beat: CollectionEntry<'beats'> }
const { beat } = Astro.props;
const d = beat.data as any;
const items: { label: string; body?: string; note?: string }[] = d.items ?? [];
---

<section class="sq" id={d.slug_id}>
  <SectionHeader index={d.order} eyebrow={d.eyebrow} />

  <h2 class="beat-title">{d.title}</h2>
  {d.sub && <p class="beat-sub">{d.sub}</p>}

  <ul class="sq-list" role="list">
    {items.map((it) => (
      <li class="sq-row">
        <div class="sq-main">
          <h3 class="sq-label">{it.label}</h3>
          <p class="sq-body">{it.body}</p>
        </div>
        {it.note && (
          <p class="sq-note">
            <span class="sq-note-key">FAILURE MODES</span>
            <span class="sq-note-val">{it.note}</span>
          </p>
        )}
      </li>
    ))}
  </ul>

  <div class="beat-note"><slot /></div>
</section>

<style>
  .sq-list {
    list-style: none;
    padding: 0;
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    border-top: 1px solid var(--color-rule);
  }
  .sq-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 16rem;
    gap: 1.5rem;
    align-items: start;
    padding: clamp(1.35rem, 3vw, 2rem) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .sq-label {
    font-family: var(--font-data);
    font-weight: 500;
    font-size: clamp(0.82rem, 1.6vw, 0.95rem);
    letter-spacing: 0.2em;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }
  .sq-body {
    color: var(--color-text);
    font-size: clamp(0.98rem, 1.7vw, 1.12rem);
    line-height: 1.55;
    max-width: 48ch;
  }
  .sq-note {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-left: 1.25rem;
    border-left: 1px solid var(--color-border);
  }
  .sq-note-key {
    font-family: var(--font-data);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    color: var(--color-text-faint);
  }
  .sq-note-val {
    font-family: var(--font-data);
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .sq-row { grid-template-columns: minmax(0, 1fr); }
    .sq-note {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--color-border);
      padding-top: 0.85rem;
      margin-top: 0.35rem;
    }
  }
</style>

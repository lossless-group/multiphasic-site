---
/* SectionHeader — the index plate that hangs off the page's axis rail.
 *
 * The eight beats are an ordered argument, so the index is information:
 * it tells the reader where they are in a sequence they are meant to follow
 * end to end. It is set in the data face because it is a coordinate, not a
 * word. The hairline under it draws itself in on reveal. */
export interface Props {
  index: number;
  eyebrow?: string;
  id?: string;
}
const { index, eyebrow = '', id } = Astro.props;
const n = String(index).padStart(2, '0');
---

<header class="sh" id={id}>
  <p class="sh-index">
    <span class="sh-n">{n}</span>
    <span class="sh-slash">/</span>
    <span class="sh-eyebrow">{eyebrow}</span>
  </p>
  <span class="sh-rule" data-reveal></span>
</header>

<style>
  .sh { margin-bottom: 2.25rem; }
  .sh-index {
    display: flex;
    align-items: baseline;
    gap: 0.6ch;
    font-family: var(--font-data);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    margin-bottom: 0.75rem;
  }
  .sh-n { color: var(--color-primary); font-weight: 500; }
  .sh-slash { color: var(--color-text-faint); }
  .sh-eyebrow { color: var(--color-text-muted); }
  .sh-rule {
    display: block;
    height: 1px;
    background: var(--color-rule);
    transform-origin: left center;
  }
  :global(html.has-reveal) .sh-rule { transform: scaleX(0); }
  :global(html.has-reveal) .sh-rule.is-in {
    transform: scaleX(1);
    transition: transform 800ms cubic-bezier(0.2, 0.7, 0.25, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.has-reveal) .sh-rule { transform: scaleX(1); }
  }
</style>

---
import DiptychSection from './DiptychSection.astro';
import DiptychRow from './DiptychRow.astro';
import type { CollectionEntry } from 'astro:content';

/* ============================================================================
 * Beat 1 — Thesis.
 *
 * The chosen hero line is the deck's own: "From materials processing to
 * materials programming." It is the only candidate that is already a diptych.
 * Broken at its hinge word it sets itself across the beam — "From materials
 * processing" on paper, "to materials programming." on navy — which states the
 * direction's entire thesis in the first screen without a word of explanation.
 *
 * `sub` splits the same way: its first sentence is a negation (what the
 * breakthrough isn't) and belongs left; its second is the affirmation and
 * belongs right.
 * ========================================================================== */

export interface Props {
  beat: CollectionEntry<'beats'>;
  body?: any;
}
const { beat, body: Body } = Astro.props;
const d = beat.data as any;

/** Break the headline at its hinge so each half lands on its own ground. */
function hinge(title: string): [string, string] {
  const m = title.match(/^(.*?)\s(to\s.*)$/i);
  if (m) return [m[1], m[2]];
  const words = title.split(' ');
  const mid = Math.ceil(words.length / 2);
  return [words.slice(0, mid).join(' '), words.slice(mid).join(' ')];
}
const [titleLeft, titleRight] = hinge(d.title);

/** First sentence stays with the past; the rest crosses. */
function firstSentence(text: string): [string, string] {
  const i = text.indexOf('. ');
  if (i === -1) return [text, ''];
  return [text.slice(0, i + 1), text.slice(i + 2)];
}
const [subPast, subFuture] = firstSentence(d.sub ?? '');
---

<DiptychSection id={d.slug_id} split={50} size="tall" intensity="high">
  <DiptychRow seam={false} gap="sm" align="end">
    <div class="hero-past" slot="past">
      <p class="dx-eyebrow on-past">{d.eyebrow}</p>
      {d.kicker && <p class="hero-kicker">{d.kicker}</p>}
      <h1 class="dx-display">
        {titleLeft}<span class="sr-only"> {titleRight}</span>
      </h1>
    </div>
    <div class="hero-future" slot="future">
      <p class="dx-display hero-continuation" aria-hidden="true">{titleRight}</p>
    </div>
  </DiptychRow>

  <DiptychRow gap="none" align="start">
    <div slot="past">
      <hr class="dx-rule on-past" />
      <p class="dx-lede on-past">{subPast}</p>
    </div>
    <div slot="future">
      <hr class="dx-rule on-future" />
      <p class="dx-lede on-future">{subFuture}</p>
      {
        Body && (
          <div class="dx-prose on-future hero-body">
            <Body />
          </div>
        )
      }
      {d.cta_label && d.cta_href && <a class="dx-cta hero-cta" href={d.cta_href}>{d.cta_label}</a>}
    </div>
  </DiptychRow>
</DiptychSection>

<style>
  .hero-past {
    text-align: right;
  }
  .hero-kicker {
    font-family: var(--font-data);
    font-size: clamp(0.66rem, 0.85vw, 0.78rem);
    letter-spacing: 0.1em;
    line-height: 1.6;
    color: var(--color-past-text-muted);
    max-width: 30ch;
    margin: 1.4rem 0 2.6rem auto;
  }
  .hero-continuation {
    color: var(--color-future-text);
  }
  .hero-body {
    margin-top: 1.6rem;
  }
  .hero-cta {
    margin-top: 2rem;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 899px) {
    .hero-past {
      text-align: left;
    }
    .hero-kicker {
      margin-inline: 0;
    }
  }
</style>

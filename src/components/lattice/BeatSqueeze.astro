---
// Beat 4 — The squeeze.
//
// Three frontier duty cycles. The `note` field carries the actual failure
// modes (creep, electromigration, thermal fatigue) — set in the data face at
// the foot of each column, where an engineer will look for it and a generalist
// can skip it.

export interface Props {
  data: Record<string, any>;
}
const { data } = Astro.props;
const items: Array<Record<string, string>> = data.items ?? [];
---

<h2 class="lx-display-l lx-rise" id="beat-the-squeeze">{data.title}</h2>
{data.sub && <p class="lx-lede lx-rise squeeze-sub">{data.sub}</p>}

<ul class="squeeze-row">
  {items.map((it) => (
    <li class="squeeze-col lx-rise">
      <span class="squeeze-label">{it.label}</span>
      {it.body && <p class="lx-body">{it.body}</p>}
      {it.note && <span class="squeeze-note">{it.note}</span>}
    </li>
  ))}
</ul>


<style>
  .squeeze-sub { max-width: 40ch; margin-top: 1.75rem; }

  .squeeze-row {
    list-style: none;
    margin: clamp(3rem, 7vw, 5rem) 0 0;
    padding: 0;
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }
  @media (min-width: 56rem) {
    .squeeze-row { grid-template-columns: repeat(3, 1fr); }
  }

  .squeeze-col {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--fx-hairline);
  }
  .squeeze-label {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(0.95rem, 1.5vw, 1.15rem);
    letter-spacing: 0.06em;
    color: var(--color-text);
  }
  .squeeze-note {
    margin-top: auto;
    padding-top: 0.75rem;
    font-family: var(--font-data);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    color: var(--color-conditioned);
  }
</style>

---
// Beat 8 — The ask. Deliberately quiet.
//
// After seven full-bleed held moments the close should feel like the lights
// coming up: normal type sizes, one action, the lockup, nothing else.

import Wordmark from '../basics/Wordmark.astro';

export interface Props {
  data: Record<string, any>;
  closing?: string;
}
const { data, closing } = Astro.props;
---

<div class="ask">
  <h2 class="ask-title lx-rise" id="beat-contact">{data.title}</h2>
  {data.sub && <p class="lx-body ask-sub lx-rise">{data.sub}</p>}
  {data.cta_href && (
    <a class="lx-cta lx-rise" href={data.cta_href}>{data.cta_label ?? 'Get in touch'}</a>
  )}
</div>

<footer class="ask-foot">
  <Wordmark size={26} />
  {closing && <span class="lx-micro">{closing}</span>}
</footer>

<style>
  .ask {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    max-width: 34ch;
  }
  .ask-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.5rem, 3.6vw, 2.6rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--color-text);
  }
  .ask-sub { max-width: 44ch; }

  .ask-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    margin-top: clamp(4rem, 10vw, 7rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--fx-hairline);
  }
</style>

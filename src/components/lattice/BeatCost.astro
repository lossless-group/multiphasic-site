---
// Beat 3 — The cost.
//
// Four numbers, set in the display face at hero scale rather than in the data
// face. Direction A puts numbers in monospace because it is arguing as an
// instrument; this direction is arguing as a manifesto, so the numbers are
// typography, not readout. The mono is spent on the labels instead.
//
// The `qualifier` ("up to") is kept — it is the honest part of the claim and
// hiding it would be a different company.

export interface Props {
  data: Record<string, any>;
  /** Source note from the markdown body — kept, small, once. */
  note?: string;
}
const { data, note } = Astro.props;
const stats: Array<Record<string, string>> = data.stats ?? [];
---

<h2 class="lx-display-l lx-rise" id="beat-the-cost">{data.title}</h2>

<ul class="cost-grid">
  {stats.map((s) => (
    <li class="cost-cell lx-rise">
      <span class="cost-label">{s.label}</span>
      <p class="cost-figure">
        {s.qualifier && <span class="cost-qual">{s.qualifier}</span>}
        <span class="cost-value">{s.value}</span>
      </p>
      {s.body && <p class="lx-body cost-body">{s.body}</p>}
    </li>
  ))}
</ul>

{note && <p class="lx-micro cost-note lx-rise">{note}</p>}

<style>
  .cost-grid {
    list-style: none;
    margin: clamp(3rem, 7vw, 5.5rem) 0 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--fx-hairline);
  }
  @media (min-width: 46rem) {
    .cost-grid { grid-template-columns: 1fr 1fr; }
  }

  .cost-cell {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(1.75rem, 4vw, 2.75rem) 0;
    border-bottom: 1px solid var(--fx-hairline);
  }
  @media (min-width: 46rem) {
    .cost-cell { padding-inline: clamp(1.5rem, 3vw, 3rem); }
    .cost-cell:nth-child(odd) { padding-inline-start: 0; border-inline-end: 1px solid var(--fx-hairline); }
    .cost-cell:nth-child(even) { padding-inline-end: 0; }
  }

  .cost-label {
    font-family: var(--font-data);
    font-size: 0.625rem;
    letter-spacing: 0.24em;
    color: var(--color-conditioned);
  }

  .cost-figure {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .cost-qual {
    font-family: var(--font-data);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }
  .cost-value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3.25rem, 9vw, 6.5rem);
    line-height: 0.85;
    letter-spacing: -0.05em;
    color: var(--color-text);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .cost-body { max-width: 34ch; }
  .cost-note { margin-top: 1.75rem; }
</style>
